{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/block-repo-push.py\"",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/block-repo-push.py\"",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/block-repo-push.py\"",
        "matcher": "Shell",
        "failClosed": true,
        "timeout": 10
      }
    ]
  }
}
